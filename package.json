{
  "name": "dsh-token-dog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Token usage for the DeepSeek Harness Web GUI: per-session and per-model totals, a daily stacked bar chart, and a year-long calendar heatmap.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "token-usage",
    "usage",
    "heatmap"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccoderJava/dsh-token-dog.git"
  },
  "homepage": "https://github.com/ccoderJava/dsh-token-dog#readme",
  "bugs": {
    "url": "https://github.com/ccoderJava/dsh-token-dog/issues"
  }
}
